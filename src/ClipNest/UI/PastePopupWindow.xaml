<Window x:Class="ClipNest.UI.PastePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClipNest.UI.ViewModels"
        xmlns:infra="clr-namespace:ClipNest.UI.Infrastructure"
        Title="{DynamicResource Str_PickerTitle}"
        Width="320"
        SizeToContent="Height"
        MaxHeight="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Transparent"
        FontFamily="{StaticResource FontUi}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <infra:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />

        <!-- 修改（铅笔）：点它打开主窗口并定位到该条 -->
        <Geometry x:Key="EditIconGeometry">M3,17.25 L14.5,5.75 L18.25,9.5 L6.75,21 L3,21 Z M14.5,5.75 L16.5,3.75 L20.25,7.5 L18.25,9.5 Z</Geometry>

        <Style x:Key="PickerItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Margin="2,0.5"
                                Padding="6,3"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedBg}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 影子单独一层，内容层不带 Effect -->
        <Border Margin="4" Padding="14" Background="Transparent">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.28" BlurRadius="18" ShadowDepth="3" Direction="270" />
            </Border.Effect>
            <Border Background="{DynamicResource WindowBg}" CornerRadius="10" />
        </Border>

        <Border Margin="18"
                Background="{DynamicResource WindowBg}"
                BorderBrush="{DynamicResource BorderStrong}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 搜索 -->
                <Grid Grid.Row="0" Margin="12,12,12,8">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource PlainTextBox}"
                             Height="32" FontSize="13"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="OnSearchKeyDown" />
                    <TextBlock Text="{DynamicResource Str_SearchHistory}"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextMuted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- 历史列表：高度跟着条目走，条目多到超过上限才滚动 -->
                <Border Grid.Row="1"
                        Margin="12,0,12,0"
                        MinHeight="96"
                        MaxHeight="360"
                        Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource BorderSoft}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <ListBox x:Name="HistoryList"
                                 ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource PickerItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0,2"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ClipRow}">
                                    <Grid Height="22">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="18" Height="18"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource AccentSoft}"
                                                CornerRadius="4">
                                            <TextBlock Text="{Binding TypeGlyph}"
                                                       FontSize="9.5"
                                                       Foreground="{DynamicResource Accent}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Preview}"
                                                   Margin="7,0,5,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TimeText}"
                                                   FontSize="9.5"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center" />

                                        <!-- 修改：仅悬停该行时才显示，点它打开主窗口并选中这条 -->
                                        <Button Grid.Column="3"
                                                x:Name="EditButton"
                                                Click="OnEditClick"
                                                Width="22" Height="22"
                                                Margin="5,0,0,0"
                                                Padding="0"
                                                ToolTip="{DynamicResource Str_Edit}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="{StaticResource EditIconGeometry}"
                                                  Width="12" Height="12"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{DynamicResource Str_NoMatch}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
