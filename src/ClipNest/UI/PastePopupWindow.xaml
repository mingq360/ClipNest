<Window x:Class="ClipNest.UI.PastePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClipNest.UI.ViewModels"
        xmlns:infra="clr-namespace:ClipNest.UI.Infrastructure"
        Title="ClipNest 历史"
        Width="436"
        SizeToContent="Height"
        MaxHeight="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Transparent"
        FontFamily="{StaticResource FontUi}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <infra:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />

        <Style x:Key="PickerItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Margin="6,1"
                                Padding="9,6"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedBg}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 影子单独一层，内容层不带 Effect -->
        <Border Margin="4" Padding="14" Background="Transparent">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.28" BlurRadius="18" ShadowDepth="3" Direction="270" />
            </Border.Effect>
            <Border Background="{DynamicResource WindowBg}" CornerRadius="10" />
        </Border>

        <Border Margin="18"
                Background="{DynamicResource WindowBg}"
                BorderBrush="{DynamicResource BorderStrong}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 搜索 -->
                <Grid Grid.Row="0" Margin="12,12,12,8">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource PlainTextBox}"
                             Height="32" FontSize="13"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="OnSearchKeyDown" />
                    <TextBlock Text="搜索历史记录…"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextMuted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- 历史列表：高度跟着条目走，条目多到超过上限才滚动 -->
                <Border Grid.Row="1"
                        Margin="12,0,12,0"
                        MinHeight="110"
                        MaxHeight="380"
                        Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource BorderSoft}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <ListBox x:Name="HistoryList"
                                 ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource PickerItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0,4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 MouseDoubleClick="OnListDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ClipRow}">
                                    <Grid Height="26">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="20" Height="20"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource AccentSoft}"
                                                CornerRadius="5">
                                            <TextBlock Text="{Binding TypeGlyph}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource Accent}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Preview}"
                                                   Margin="8,0,6,0"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TimeText}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="没有匹配的记录"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <!-- 底部提示 -->
                <Grid Grid.Row="2" Margin="14,9,14,11">
                    <TextBlock Text="↑↓ 选择 · Enter 粘贴到刚才的窗口 · Esc 取消"
                               FontSize="10.5"
                               Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
