<Window x:Class="ClipNest.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:ClipNest.UI.Controls"
        Title="ClipNest 设置"
        Width="620" Height="660"
        MinWidth="520" MinHeight="480"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        Icon="{StaticResource AppIconImage}"
        FontFamily="{StaticResource FontUi}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldHelp" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="{StaticResource WindowBg}" MouseLeftButtonDown="OnHeaderMouseDown">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Image Source="{StaticResource AppIconImage}" Width="15" Height="15" />
                    <TextBlock x:Name="TitleText" Text="设置" Margin="7,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="✕" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                        Margin="0,0,7,0" Click="OnCancelClick" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,4,16,0">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                </ScrollViewer.Resources>

                <StackPanel>
                    <!-- 首次启动引导 -->
                    <Border x:Name="WelcomeCard" Style="{StaticResource Section}"
                            Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="先定两件事" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                            <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                                       Text="第一，用哪个快捷键唤起这个窗口；第二，哪些应用的内容你不想被收录。剩下的都可以以后再改。" />
                        </StackPanel>
                    </Border>

                    <!-- 采集 -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="采集" Style="{StaticResource SectionTitle}" />

                            <CheckBox x:Name="EnableMonitorCheck" Style="{StaticResource SoftCheckBox}"
                                      Content="启用剪贴板监听" />
                            <TextBlock Style="{StaticResource FieldHelp}" Margin="24,4,0,12"
                                       Text="关闭后完全停止采集，效果等同于一直暂停。" />

                            <CheckBox x:Name="ManualOnlyCheck" Style="{StaticResource SoftCheckBox}"
                                      Content="仅手动收藏模式" />
                            <TextBlock Style="{StaticResource FieldHelp}" Margin="24,4,0,0"
                                       Text="开启后，普通复制不再入库，只有按「主动收藏」快捷键才会保存当前剪贴板内容。" />
                        </StackPanel>
                    </Border>

                    <!-- 隐私 -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="隐私" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="不采集以下应用（每行一个进程名）" />
                            <TextBox x:Name="ExcludedAppsBox" Style="{StaticResource PlainTextBox}"
                                     Margin="0,8,0,0" Height="86"
                                     AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="{StaticResource FontMono}" FontSize="12" />
                            <TextBlock Style="{StaticResource FieldHelp}"
                                       Text="按进程名匹配，写成 1password 或 1password.exe 都行。注意：这只能区分程序，区分不了浏览器里打开的网页版密码管理器。" />
                        </StackPanel>
                    </Border>

                    <!-- 容量 -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="容量" Style="{StaticResource SectionTitle}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="最多保存" />
                                <TextBox x:Name="MaxItemsBox" Style="{StaticResource PlainTextBox}"
                                         Width="94" Margin="8,0" TextAlignment="Right"
                                         FontFamily="{StaticResource FontMono}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="条" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource FieldHelp}"
                                       Text="超出后自动删除最旧的非置顶、非收藏片段。置顶与收藏的片段永远不会被自动清理，所以它们的数量可以超过这个上限。" />
                        </StackPanel>
                    </Border>

                    <!-- 快捷键 -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="快捷键" Style="{StaticResource SectionTitle}" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="唤起主窗口" />
                                <controls:HotKeyBox Grid.Column="1" x:Name="ToggleHotKeyBox" />
                                <CheckBox Grid.Column="2" x:Name="ToggleHotKeyEnabled" Style="{StaticResource SoftCheckBox}"
                                          Content="启用" Margin="12,0,0,0" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="主动收藏当前剪贴板" />
                                <controls:HotKeyBox Grid.Column="1" x:Name="ManualHotKeyBox" />
                                <CheckBox Grid.Column="2" x:Name="ManualHotKeyEnabled" Style="{StaticResource SoftCheckBox}"
                                          Content="启用" Margin="12,0,0,0" />
                            </Grid>

                            <TextBlock Style="{StaticResource FieldHelp}"
                                       Text="全局快捷键是系统独占的：注册成功后，其他程序在本地按同一组合键会收不到。若提示冲突，换一个组合即可。" />
                        </StackPanel>
                    </Border>

                    <!-- 其他 -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="其他" Style="{StaticResource SectionTitle}" />

                            <CheckBox x:Name="AutoStartCheck" Style="{StaticResource SoftCheckBox}" Content="开机自动启动" />
                            <CheckBox x:Name="HideOnLostFocusCheck" Style="{StaticResource SoftCheckBox}"
                                      Content="窗口失去焦点时自动隐藏" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 数据 -->
                    <Border Style="{StaticResource Section}" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="数据" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="DataPathText" Style="{StaticResource FieldHelp}" Margin="0,0,0,10"
                                       FontFamily="{StaticResource FontMono}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="打开数据目录" Style="{StaticResource GhostButton}" Click="OnOpenDataFolderClick" />
                                <Button Content="清空未收藏的片段" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Click="OnClearClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <TextBlock x:Name="ErrorText" VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{StaticResource Danger}" TextWrapping="Wrap" MaxWidth="360"
                               HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="取消" Style="{StaticResource GhostButton}" Padding="18,7" Click="OnCancelClick" />
                        <Button Content="保存" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OnSaveClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
