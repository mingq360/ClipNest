<Window x:Class="ClipNest.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClipNest.UI.Controls"
        Title="{DynamicResource Str_SettingsTitle}"
        Width="648"
        Height="470"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Icon="{StaticResource AppIconImage}"
        FontFamily="{StaticResource FontUi}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!--
        投影走 AllowsTransparency + DropShadowEffect，而不是 DWM 扩展边框：
        ResizeMode=NoResize 的窗口缺少 WS_THICKFRAME，DWM 不再投阴影。
        代价是这个窗口退回软件合成（小窗可以接受），换来任何缩放比下都稳定的阴影。
        窗口比可见卡片大 14px 一圈，留给阴影扩散。
    -->

    <Window.Resources>
        <!-- 全局细滚动条，省得每个 ScrollViewer 里重复写（文本框等内部仍可能用到） -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldHelp" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- 左栏导航项 -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                Padding="{TemplateBinding Padding}" CornerRadius="7">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 选中态：始终高亮，优先级最高 -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <!-- 悬停底色仅在「未选中」时生效，避免盖掉选中高亮 -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBg}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 每个分页内容：顶部对齐，避免底部留白被拉伸 -->
        <Style x:Key="PagePanel" TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!-- 主题色色块容器：去掉默认选中底板，选中样式画在模板内部 -->
        <Style x:Key="AccentItemStyle" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent" Padding="2">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!--
            影子单独占一层，内容层不带 Effect —— 否则整棵子树会被栅格化，文字丢掉 ClearType。
            影子层用 Margin=4 + Padding=14，让它的位图比卡片大一圈，阴影才有地方扩散。
        -->
        <Border Margin="4" Padding="14" Background="Transparent">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.26" BlurRadius="16" ShadowDepth="2" Direction="270" />
            </Border.Effect>
            <Border Background="{DynamicResource WindowBg}" CornerRadius="10" />
        </Border>

        <Border Margin="18"
                Background="{DynamicResource WindowBg}"
                BorderBrush="{DynamicResource BorderStrong}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="Auto" />
                    <!-- 主体占满剩余高度：左导航 + 右内容 -->
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Grid Grid.Row="0" Background="{DynamicResource WindowBg}" MouseLeftButtonDown="OnHeaderMouseDown">
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Image Source="{StaticResource AppIconImage}" Width="15" Height="15" />
                        <TextBlock x:Name="TitleText" Margin="7,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Content="✕" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                            Margin="0,0,7,0" Click="OnCloseClick" ToolTip="{DynamicResource Str_CloseHint}" />
                </Grid>

                <!-- 首次启动引导 -->
                <Border x:Name="WelcomeCard" Grid.Row="1"
                        Background="{DynamicResource AccentSoft}"
                        BorderBrush="{DynamicResource Accent}"
                        BorderThickness="1,0,0,0"
                        Padding="16,10"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_WelcomeHeading}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                        <TextBlock Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                                   Text="{DynamicResource Str_WelcomeText}" />
                    </StackPanel>
                </Border>

                <!-- 主体：左导航 + 右内容 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="142" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧导航栏 -->
                    <ListBox x:Name="NavList"
                             Grid.Column="0"
                             Background="{DynamicResource SurfaceBg}"
                             BorderThickness="0"
                             Padding="8,10"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             SelectionChanged="OnNavSelectionChanged"
                             SelectedIndex="0">
                        <ListBoxItem Content="{DynamicResource Str_TabCapture}" />
                        <ListBoxItem Content="{DynamicResource Str_TabPrivacy}" />
                        <ListBoxItem Content="{DynamicResource Str_TabHotkeys}" />
                        <ListBoxItem Content="{DynamicResource Str_TabAppearance}" />
                        <ListBoxItem Content="{DynamicResource Str_TabOther}" />
                    </ListBox>

                    <!-- 分隔线 -->
                    <Border Grid.Column="1" Width="1" Margin="0,8"
                            Background="{DynamicResource BorderSoft}" />

                    <!-- 右侧内容区：滚条藏起来（不显示滚动条），内容超高时仍可滚轮查看，不会裁切 -->
                    <Border Grid.Column="2" Padding="18,14" Background="{DynamicResource WindowBg}">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="Pages">
                            <!-- ===== 采集 ===== -->
                            <StackPanel x:Name="PageCapture" Style="{StaticResource PagePanel}">
                                <Border Style="{StaticResource Section}">
                                    <StackPanel>
                                        <CheckBox x:Name="EnableMonitorCheck" Style="{StaticResource SoftCheckBox}"
                                                  Content="{DynamicResource Str_EnableMonitor}" Click="OnCaptureSettingChanged" />
                                        <TextBlock Style="{StaticResource FieldHelp}" Margin="24,4,0,12"
                                                   Text="{DynamicResource Str_EnableMonitorHelp}" />

                                        <CheckBox x:Name="ManualOnlyCheck" Style="{StaticResource SoftCheckBox}"
                                                  Content="{DynamicResource Str_ManualOnly}" Click="OnCaptureSettingChanged" />
                                        <TextBlock Style="{StaticResource FieldHelp}" Margin="24,4,0,0"
                                                   Text="{DynamicResource Str_ManualOnlyHelp}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Section}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str_Capacity}" Style="{StaticResource SectionTitle}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_MaxItems}" />
                                            <TextBox x:Name="MaxItemsBox" Style="{StaticResource PlainTextBox}"
                                                     Width="94" Margin="8,0" TextAlignment="Right"
                                                     FontFamily="{StaticResource FontMono}"
                                                     LostFocus="OnNumericSettingChanged"
                                                     KeyDown="OnNumericBoxKeyDown" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Items}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource FieldHelp}"
                                                   Text="{DynamicResource Str_MaxItemsHelp}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_MaxCharsLabel}" />
                                            <TextBox x:Name="MaxCharsBox" Style="{StaticResource PlainTextBox}"
                                                     Width="94" Margin="8,0" TextAlignment="Right"
                                                     FontFamily="{StaticResource FontMono}"
                                                     LostFocus="OnNumericSettingChanged"
                                                     KeyDown="OnNumericBoxKeyDown" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Chars}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource FieldHelp}"
                                                   Text="{DynamicResource Str_MaxCharsHelp}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== 隐私 ===== -->
                            <StackPanel x:Name="PagePrivacy" Style="{StaticResource PagePanel}" Visibility="Collapsed">
                                <Border Style="{StaticResource Section}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str_ExcludedApps}" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_ExcludedAppsHint}" />
                                        <TextBox x:Name="ExcludedAppsBox" Style="{StaticResource PlainTextBox}"
                                                 Margin="0,8,0,0" Height="170"
                                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top"
                                                 FontFamily="{StaticResource FontMono}" FontSize="12"
                                                 LostFocus="OnExcludedAppsChanged" />
                                        <TextBlock Style="{StaticResource FieldHelp}"
                                                   Text="{DynamicResource Str_ExcludedAppsHelp}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== 快捷键 ===== -->
                            <StackPanel x:Name="PageHotkeys" Style="{StaticResource PagePanel}" Visibility="Collapsed">
                                <Border Style="{StaticResource Section}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str_GlobalHotkeys}" Style="{StaticResource SectionTitle}" />

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_MainWindowLabel}" />
                                            <controls:HotKeyBox Grid.Column="1" x:Name="ToggleHotKeyBox" GestureChanged="OnHotKeyGestureChanged" />
                                            <CheckBox Grid.Column="2" x:Name="ToggleHotKeyEnabled" Style="{StaticResource SoftCheckBox}"
                                                      Content="{DynamicResource Str_Enable}" Margin="12,0,0,0" Click="OnHotKeyChanged" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_PickerLabel}" />
                                            <controls:HotKeyBox Grid.Column="1" x:Name="ManualHotKeyBox" GestureChanged="OnHotKeyGestureChanged" />
                                            <CheckBox Grid.Column="2" x:Name="ManualHotKeyEnabled" Style="{StaticResource SoftCheckBox}"
                                                      Content="{DynamicResource Str_Enable}" Margin="12,0,0,0" Click="OnHotKeyChanged" />
                                        </Grid>

                                        <TextBlock Style="{StaticResource FieldHelp}"
                                                   Text="{DynamicResource Str_HotkeysHelp}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== 外观 ===== -->
                            <StackPanel x:Name="PageAppearance" Style="{StaticResource PagePanel}" Visibility="Collapsed">
                                <Border Style="{StaticResource Section}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str_ThemeMode}" Style="{StaticResource SectionTitle}" />

                                        <Border HorizontalAlignment="Left"
                                                Background="{DynamicResource WindowBg}"
                                                BorderBrush="{DynamicResource BorderSoft}"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="3">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="ThemeLightRadio" GroupName="ThemeMode" Style="{StaticResource SegmentRadio}"
                                                             Content="{DynamicResource Str_ThemeLight}" Click="OnAppearanceChanged" />
                                                <RadioButton x:Name="ThemeDarkRadio" GroupName="ThemeMode" Style="{StaticResource SegmentRadio}"
                                                             Content="{DynamicResource Str_ThemeDark}" Click="OnAppearanceChanged" />
                                                <RadioButton x:Name="ThemeSystemRadio" GroupName="ThemeMode" Style="{StaticResource SegmentRadio}"
                                                             Content="{DynamicResource Str_ThemeSystem}" Click="OnAppearanceChanged" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Style="{StaticResource FieldHelp}"
                                                   Text="{DynamicResource Str_ThemeModeHelp}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Section}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str_AccentColor}" Style="{StaticResource SectionTitle}" />

                                        <ListBox x:Name="AccentList"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 ItemContainerStyle="{StaticResource AccentItemStyle}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 SelectionChanged="OnAccentSelectionChanged">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Width="74" Margin="0,2">
                                                        <Grid Width="48" Height="46" HorizontalAlignment="Center">
                                                            <!-- 选中环画在色块外面：同色环压在色块边缘上根本看不见 -->
                                                            <Border x:Name="Ring"
                                                                    Width="46" Height="46"
                                                                    CornerRadius="23"
                                                                    BorderThickness="2"
                                                                    BorderBrush="Transparent" />
                                                            <Border x:Name="Dot"
                                                                    Width="34" Height="34"
                                                                    CornerRadius="17"
                                                                    Background="{Binding BaseBrush}" />
                                                            <TextBlock x:Name="Tick"
                                                                       Text="✓"
                                                                       FontSize="14"
                                                                       Foreground="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="Collapsed" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="11"
                                                                   Margin="0,3,0,0"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSecondary}" />
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock Style="{StaticResource FieldHelp}"
                                                   Text="{DynamicResource Str_AccentColorHelp}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== 其他 ===== -->
                            <StackPanel x:Name="PageOther" Style="{StaticResource PagePanel}" Visibility="Collapsed">
                                <Border Style="{StaticResource Section}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{DynamicResource Str_Language}"
                                                   Style="{StaticResource FieldLabel}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  x:Name="LanguageCombo"
                                                  Style="{StaticResource FilterComboBox}"
                                                  Width="200"
                                                  Margin="12,0,0,0"
                                                  HorizontalAlignment="Left"
                                                  SelectionChanged="OnLanguageChanged">
                                            <ComboBoxItem Content="{DynamicResource Str_LangChinese}" />
                                            <ComboBoxItem Content="{DynamicResource Str_LangEnglish}" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Section}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str_StartupWindow}" Style="{StaticResource SectionTitle}" />
                                        <CheckBox x:Name="AutoStartCheck" Style="{StaticResource SoftCheckBox}"
                                                  Content="{DynamicResource Str_AutoStart}" Click="OnAutoStartChanged" />
                                        <CheckBox x:Name="HideOnLostFocusCheck" Style="{StaticResource SoftCheckBox}"
                                                  Content="{DynamicResource Str_HideOnLostFocus}" Margin="0,10,0,0" Click="OnCaptureSettingChanged" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Section}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str_Data}" Style="{StaticResource SectionTitle}" />
                                        <TextBlock x:Name="DataPathText" Style="{StaticResource FieldHelp}" Margin="0,0,0,10"
                                                   FontFamily="{StaticResource FontMono}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{DynamicResource Str_OpenDataFolder}" Style="{StaticResource GhostButton}" Click="OnOpenDataFolderClick" />
                                            <Button Content="{DynamicResource Str_ClearUnfavorited}" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                                    Click="OnClearClick" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource FieldHelp}"
                                                   Text="{DynamicResource Str_DataHelp}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 底部：只在有校验错误时出现 -->
                <Border x:Name="ErrorBar" Grid.Row="3"
                        BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0"
                        Padding="16,9"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
