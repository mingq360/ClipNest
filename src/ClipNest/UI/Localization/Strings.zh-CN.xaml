<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <!-- ============ 通用 ============ -->
    <s:String x:Key="Str_AppName">ClipNest</s:String>
    <s:String x:Key="Str_CloseHint">关闭 (Esc)</s:String>

    <!-- ============ 设置窗口 ============ -->
    <s:String x:Key="Str_SettingsTitle">ClipNest 设置</s:String>
    <s:String x:Key="Str_Settings">设置</s:String>
    <s:String x:Key="Str_SettingsFirstRun">初次设置</s:String>

    <s:String x:Key="Str_WelcomeHeading">先定两件事</s:String>
    <s:String x:Key="Str_WelcomeText">用哪个快捷键唤出窗口（「快捷键」页），以及哪些应用的内容不要收录（「隐私」页）。其余都可以以后再改。</s:String>

    <s:String x:Key="Str_TabCapture">采集</s:String>
    <s:String x:Key="Str_TabPrivacy">隐私</s:String>
    <s:String x:Key="Str_TabHotkeys">快捷键</s:String>
    <s:String x:Key="Str_TabAppearance">外观</s:String>
    <s:String x:Key="Str_TabOther">其他</s:String>

    <!-- 采集 -->
    <s:String x:Key="Str_EnableMonitor">启用剪贴板监听</s:String>
    <s:String x:Key="Str_EnableMonitorHelp">关闭后完全停止采集，效果等同于一直暂停。</s:String>
    <s:String x:Key="Str_ManualOnly">仅手动收藏模式</s:String>
    <s:String x:Key="Str_ManualOnlyHelp">开启后，普通复制不再入库；只有按「历史选择并粘贴」快捷键时，才会把当时的剪贴板内容收进来。</s:String>
    <s:String x:Key="Str_Capacity">容量</s:String>
    <s:String x:Key="Str_MaxItems">最多保存</s:String>
    <s:String x:Key="Str_Items">条</s:String>
    <s:String x:Key="Str_MaxItemsHelp">超出后自动删除最旧的非置顶、非收藏片段。置顶与收藏的片段不会被自动清理，所以它们的数量可以超过这个上限。</s:String>
    <s:String x:Key="Str_MaxCharsLabel">单条最多</s:String>
    <s:String x:Key="Str_Chars">字符</s:String>
    <s:String x:Key="Str_MaxCharsHelp">复制超长内容（比如整份日志）时截断保存，避免一次粘贴几 MB 撑爆索引。</s:String>

    <!-- 隐私 -->
    <s:String x:Key="Str_ExcludedApps">不采集以下应用</s:String>
    <s:String x:Key="Str_ExcludedAppsHint">每行一个进程名</s:String>
    <s:String x:Key="Str_ExcludedAppsHelp">定义成 1password 或 1password.exe 都行，忽略大小写。注意：这只能区分程序，区分不了浏览器里打开的网页版密码管理器 —— 遇到那种情况请改用「暂停采集」。</s:String>

    <!-- 快捷键 -->
    <s:String x:Key="Str_GlobalHotkeys">全局快捷键</s:String>
    <s:String x:Key="Str_MainWindowLabel">主窗口</s:String>
    <s:String x:Key="Str_PickerLabel">历史选择并粘贴</s:String>
    <s:String x:Key="Str_Enable">启用</s:String>
    <s:String x:Key="Str_HotkeysHelp">按下后会弹出历史记录菜单，选中一条即自动粘贴到刚才光标所在的输入框。全局快捷键是排他的：注册后，其他程序在本地按同一组合键会收不到，冲突时换一个组合即可。</s:String>

    <!-- 外观 -->
    <s:String x:Key="Str_ThemeMode">主题模式</s:String>
    <s:String x:Key="Str_ThemeLight">浅色</s:String>
    <s:String x:Key="Str_ThemeDark">深色</s:String>
    <s:String x:Key="Str_ThemeSystem">跟随系统</s:String>
    <s:String x:Key="Str_ThemeModeHelp">默认浅色。「跟随系统」会读取 Windows 的浅色/深色设置，系统切换时本窗口立即跟着变。</s:String>
    <s:String x:Key="Str_AccentColor">主题色</s:String>
    <s:String x:Key="Str_AccentColorHelp">主题色用于强调、选中态与按钮，立即生效。</s:String>

    <!-- 其他 -->
    <s:String x:Key="Str_StartupWindow">启动与窗口</s:String>
    <s:String x:Key="Str_AutoStart">开机自动启动</s:String>
    <s:String x:Key="Str_HideOnLostFocus">窗口失去焦点时自动隐藏</s:String>
    <s:String x:Key="Str_Data">数据</s:String>
    <s:String x:Key="Str_OpenDataFolder">打开数据目录</s:String>
    <s:String x:Key="Str_ClearUnfavorited">清空未收藏的片段</s:String>
    <s:String x:Key="Str_DataHelp">数据只存在本机，不上传、不联网。此操作不可撤销。</s:String>

    <!-- 语言 -->
    <s:String x:Key="Str_Language">语言</s:String>
    <s:String x:Key="Str_LangChinese">中文</s:String>
    <s:String x:Key="Str_LangEnglish">English</s:String>

    <!-- 设置窗口错误/提示 -->
    <s:String x:Key="Str_ErrAutoStart">写入开机自启失败（注册表不可写）</s:String>
    <s:String x:Key="Str_ErrHotkeyToggle">唤起主窗口的快捷键无效：{0}</s:String>
    <s:String x:Key="Str_ErrHotkeyManual">主动收藏的快捷键无效：{0}</s:String>
    <s:String x:Key="Str_ErrHotkeySame">两个快捷键不能相同</s:String>
    <s:String x:Key="Str_ErrRange">{0} 需填 {1} ~ {2} 之间的整数，已还原为 {3}</s:String>
    <s:String x:Key="Str_ErrOpenFolder">打开数据目录失败</s:String>
    <s:String x:Key="Str_ClearTitle">清空未收藏的片段</s:String>
    <s:String x:Key="Str_ClearEmpty">现在没有任何片段。</s:String>
    <s:String x:Key="Str_ClearConfirm">将删除除「置顶」和「收藏」之外的全部片段，共 {0} 条中可能有大部分会被删掉。

此操作不可撤销，确定继续吗？</s:String>
    <s:String x:Key="Str_ClearDone">已删除 {0} 条片段。</s:String>

    <!-- ============ 主窗口 ============ -->
    <s:String x:Key="Str_SearchPlaceholder">搜索片段…   按 / 回到搜索框</s:String>
    <s:String x:Key="Str_PinnedTag">置顶</s:String>
    <s:String x:Key="Str_EmptyTitle">巢还是空的</s:String>
    <s:String x:Key="Str_GripTip">拖动可调整左右宽度</s:String>
    <s:String x:Key="Str_Copy">复制</s:String>
    <s:String x:Key="Str_Pin">置顶</s:String>
    <s:String x:Key="Str_Star">收藏</s:String>
    <s:String x:Key="Str_Delete">删除</s:String>
    <s:String x:Key="Str_Save">保存</s:String>
    <s:String x:Key="Str_SaveHint">保存 (Ctrl+S)</s:String>
    <s:String x:Key="Str_Back">后退</s:String>
    <s:String x:Key="Str_Forward">前进</s:String>
    <s:String x:Key="Str_Source">来源</s:String>
    <s:String x:Key="Str_NoSelection">选中左侧任意片段即可预览全文</s:String>
    <s:String x:Key="Str_StatusBar">↑↓ 选择 · Enter 复制 · Esc 收起</s:String>
    <s:String x:Key="Str_TooltipSettings">设置</s:String>
    <s:String x:Key="Str_TooltipAbout">关于</s:String>
    <s:String x:Key="Str_TooltipHide">隐藏窗口 (Esc)</s:String>
    <s:String x:Key="Str_TooltipPause">暂停采集</s:String>
    <s:String x:Key="Str_TooltipResume">恢复采集</s:String>

    <!-- ============ 关于 ============ -->
    <s:String x:Key="Str_AboutTitle">关于 ClipNest</s:String>
    <s:String x:Key="Str_About">关于</s:String>
    <s:String x:Key="Str_Version">版本 {0}</s:String>
    <s:String x:Key="Str_AboutDesc">本地优先的个人碎片信息收集工具。复制过的文字留在你自己的硬盘上，随时搜回来——不上云、不联网、不需要账号。</s:String>
    <s:String x:Key="Str_Runtime">运行时</s:String>
    <s:String x:Key="Str_Storage">存储</s:String>
    <s:String x:Key="Str_DataLabel">数据</s:String>
    <s:String x:Key="Str_License">协议</s:String>
    <s:String x:Key="Str_Author">作者</s:String>
    <s:String x:Key="Str_Email">邮箱</s:String>
    <s:String x:Key="Str_ViewSource">查看源码</s:String>
    <s:String x:Key="Str_Close">关闭</s:String>
    <s:String x:Key="Str_ErrOpenSource">打开 GitHub 页面失败</s:String>

    <!-- ============ 历史选择菜单 ============ -->
    <s:String x:Key="Str_PickerTitle">ClipNest 历史</s:String>
    <s:String x:Key="Str_SearchHistory">搜索历史记录…</s:String>
    <s:String x:Key="Str_NoMatch">没有匹配的记录</s:String>
    <s:String x:Key="Str_PickerHint">↑↓ 选择 · Enter 粘贴到刚才的窗口 · Esc 取消</s:String>

    <!-- ============ 托盘 ============ -->
    <s:String x:Key="Str_TrayTooltip">ClipNest · 剪贴板历史</s:String>
    <s:String x:Key="Str_TrayTooltipPaused">ClipNest · 采集已暂停</s:String>
    <s:String x:Key="Str_TrayShow">显示 ClipNest</s:String>
    <s:String x:Key="Str_TraySettings">设置…</s:String>
    <s:String x:Key="Str_TrayPause">暂停采集</s:String>
    <s:String x:Key="Str_TrayResume">恢复采集</s:String>
    <s:String x:Key="Str_TrayClear">清空未收藏的片段…</s:String>
    <s:String x:Key="Str_TrayExit">退出</s:String>

    <!-- ============ 快捷键录制框 ============ -->
    <s:String x:Key="Str_HotkeyContinue">继续按主键…</s:String>
    <s:String x:Key="Str_HotkeyNeedModifier">需要配合 Ctrl / Alt / Shift / Win</s:String>
    <s:String x:Key="Str_HotkeyInvalidKey">这个按键不能用作快捷键</s:String>
    <s:String x:Key="Str_HotkeyPress">按下组合键…</s:String>
    <s:String x:Key="Str_HotkeyClickToRecord">点击后录制</s:String>

    <!-- ============ 视图模型（状态/筛选/提示） ============ -->
    <s:String x:Key="Str_FilterAll">全部类型</s:String>
    <s:String x:Key="Str_FilterText">文本</s:String>
    <s:String x:Key="Str_FilterLink">链接</s:String>
    <s:String x:Key="Str_FilterEmail">邮箱</s:String>
    <s:String x:Key="Str_FilterNumber">数字</s:String>

    <s:String x:Key="Str_StatusTotal">共 {0} 条</s:String>
    <s:String x:Key="Str_StatusShown">已显示最近 {0} 条</s:String>
    <s:String x:Key="Str_StatusPaused">采集已暂停</s:String>

    <s:String x:Key="Str_EmptyPaused">采集已暂停，复制的内容暂时不会被收录</s:String>
    <s:String x:Key="Str_EmptyNone">还没有收录任何片段。复制一段文字试试。</s:String>
    <s:String x:Key="Str_EmptyNoMatch">没有找到包含「{0}」的片段</s:String>

    <s:String x:Key="Str_CopyFailed">写入剪贴板失败，剪贴板可能被其他程序占用</s:String>
    <s:String x:Key="Str_ReadFailed">读取失败，详情见日志</s:String>

    <s:String x:Key="Str_Saved">已保存修改</s:String>
    <s:String x:Key="Str_SaveFailed">保存失败，详情见日志</s:String>

    <!-- ============ App 层提示 ============ -->
    <s:String x:Key="Str_AppStartFailed">ClipNest 启动失败：{0}

详情见日志：{1}</s:String>
    <s:String x:Key="Str_AppException">出了点问题：{0}

程序继续运行，详情见日志。</s:String>
    <s:String x:Key="Str_HotkeyRegTitle">快捷键注册失败</s:String>
    <s:String x:Key="Str_HotkeyRegHint">

可以到「设置 · 快捷键」里换一个组合键。</s:String>
    <s:String x:Key="Str_TrayClearEmpty">现在没有任何片段</s:String>
    <s:String x:Key="Str_TrayClearConfirm">将删除所有「未置顶且未收藏」的片段（共 {0} 条里的大部分）。

此操作不可撤销，确定继续吗？</s:String>
    <s:String x:Key="Str_TrayClearDone">已删除 {0} 条片段</s:String>

</ResourceDictionary>
