<Window x:Class="ClipNest.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="关于 ClipNest"
        Width="392"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        Icon="{StaticResource AppIconImage}"
        FontFamily="{StaticResource FontUi}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
        <StackPanel>

            <!-- 标题条：可拖动 -->
            <Grid Height="34" Background="{DynamicResource WindowBg}" MouseLeftButtonDown="OnHeaderMouseDown">
                <TextBlock Text="关于" Margin="14,0,0,0" FontSize="11.5"
                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                <Button Content="✕" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                        Width="28" Height="26" Margin="0,0,6,0" Click="OnCloseClick" />
            </Grid>

            <!-- 品牌区 -->
            <StackPanel Orientation="Horizontal" Margin="18,6,18,0">
                <Image Source="{StaticResource AppIconImage}" Width="44" Height="44"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ClipNest" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock x:Name="VersionText" Text="版本 0.1.0" Margin="0,3,0,0" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Margin="18,12,18,0" FontSize="12" TextWrapping="Wrap" LineHeight="19"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="本地优先的个人碎片信息收集工具。复制过的文字留在你自己的硬盘上，随时搜回来——不上云、不联网、不需要账号。" />

            <!-- 分隔 -->
            <Border Height="1" Margin="18,14,18,0" Background="{DynamicResource BorderSoft}" />

            <!-- 规格表 -->
            <Grid Margin="18,12,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="运行时" Style="{StaticResource MetaLabel}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text=".NET 8 · WPF" Style="{StaticResource MetaValue}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="存储" Style="{StaticResource MetaLabel}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="SQLite + FTS5 trigram" Style="{StaticResource MetaValue}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="数据" Style="{StaticResource MetaLabel}" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DataPathText" Style="{StaticResource MetaValue}"
                           FontFamily="{StaticResource FontMono}" FontSize="11" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="协议" Style="{StaticResource MetaLabel}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="MIT License" Style="{StaticResource MetaValue}" />
            </Grid>

            <!-- 分隔 -->
            <Border Height="1" Margin="18,14,18,0" Background="{DynamicResource BorderSoft}" />

            <!-- 按钮 -->
            <Grid Margin="18,12,18,16">
                <Button Content="查看源码" Style="{StaticResource GhostButton}" Padding="12,6"
                        HorizontalAlignment="Left" Click="OnOpenSourceClick" />
                <Button Content="关闭" Style="{StaticResource PrimaryButton}" Padding="20,6"
                        HorizontalAlignment="Right" Click="OnCloseClick" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
