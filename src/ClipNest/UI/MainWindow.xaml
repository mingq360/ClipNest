<Window x:Class="ClipNest.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:ClipNest.UI.ViewModels"
        xmlns:infra="clr-namespace:ClipNest.UI.Infrastructure"
        Title="ClipNest"
        Width="800" Height="450"
        MinWidth="560" MinHeight="340"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Icon="{StaticResource AppIconImage}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource FontUi}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="10"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <infra:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <infra:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />

        <!-- 用几何图形画图标，不依赖字体，任何缩放比下都清晰 -->
        <!-- 设置：三条带滑块的横线，比齿轮在 16px 下更容易认出来 -->
        <Geometry x:Key="SettingsIconGeometry">
            M3.5,6.6 H6.2 M11.4,6.6 H20.5
            M8.8,4.4 A2.2,2.2 0 1 1 8.79,4.4
            M3.5,12 H12.4 M17.6,12 H20.5
            M15,9.8 A2.2,2.2 0 1 1 14.99,9.8
            M3.5,17.4 H7.4 M12.6,17.4 H20.5
            M10,15.2 A2.2,2.2 0 1 1 9.99,15.2
        </Geometry>

        <Geometry x:Key="InfoIconGeometry">
            M12,2.6 A9.4,9.4 0 1 1 11.99,2.6 M12,11 L12,16.6 M12,7.6 L12,7.7
        </Geometry>

        <!-- 详情页操作图标：复制 / 置顶 / 收藏 / 删除 -->
        <Geometry x:Key="CopyIconGeometry">M8,8 H18 V18 H8 Z M5,5 H15 V15 H5 Z</Geometry>
        <Geometry x:Key="PinIconGeometry">M12,4 L12,16 M8,8 L12,4 L16,8 M6,16 H18</Geometry>
        <Geometry x:Key="StarIconGeometry">M12,3 L14.6,9 L21,9.5 L16,14 L17.5,20.5 L12,17 L6.5,20.5 L8,14 L3,9.5 L9.4,9 Z</Geometry>
        <Geometry x:Key="DeleteIconGeometry">M5,7 H19 M9,7 V5 H15 V7 M7,7 L8,20 H16 L17,7</Geometry>
        <!-- 来源：一个地球，表示"来自哪个应用" -->
        <Geometry x:Key="SourceIconGeometry">M12,4 A8,8 0 1 0 12,20 A8,8 0 1 0 12,4 M12,4 C15,8 15,16 12,20 M12,4 C9,8 9,16 12,20 M4,12 H20</Geometry>

        <!-- 详情页编辑操作：保存（软盘）/ 后退（撤销，逆时针）/ 前进（重做，顺时针） -->
        <Geometry x:Key="SaveIconGeometry">M4,4 H16 L20,8 V20 H4 Z M8,4 V9 H15 M8,13 H16 V19 H8 Z</Geometry>
        <Geometry x:Key="BackIconGeometry">M9,7 L5,11 L9,15 M5,11 H13 C16,11 17,13 17,16</Geometry>
        <Geometry x:Key="ForwardIconGeometry">M15,7 L19,11 L15,15 M19,11 H11 C8,11 7,13 7,16</Geometry>

        <!-- 标题栏暂停按钮：运行中=实心圆点，已暂停=双竖条 -->
        <Geometry x:Key="PauseRunningGeometry">M12,5 A7,7 0 1 0 12,19 A7,7 0 1 0 12,5 Z</Geometry>
        <Geometry x:Key="PausePausedGeometry">M8,6 H11 V18 H8 Z M13,6 H16 V18 H13 Z</Geometry>

        <Style x:Key="ClipItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Margin="4,1"
                                Padding="8,4"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedBg}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="10"
            Background="{DynamicResource WindowBg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- ================= 标题栏（自绘，可拖拽） ================= -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
                <StackPanel Orientation="Horizontal" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Image Source="{StaticResource AppIconImage}" Width="15" Height="15" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="ClipNest" Margin="7,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0">
                    <!-- 暂停采集：用图标表达状态（运行中=圆点 / 已暂停=双竖条） -->
                    <Button Command="{Binding TogglePauseCommand}"
                            Style="{StaticResource IconButton}"
                            Width="Auto" Padding="9,0" Margin="0,0,4,0"
                            ToolTip="{Binding PauseLabel}">
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource PauseRunningGeometry}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource PausePausedGeometry}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <Button Style="{StaticResource IconButton}" Click="OnSettingsClick" ToolTip="{DynamicResource Str_TooltipSettings}">
                        <Path Data="{StaticResource SettingsIconGeometry}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="16" Height="16"
                              Stretch="Uniform" />
                    </Button>

                    <Button Style="{StaticResource IconButton}" Click="OnAboutClick" ToolTip="{DynamicResource Str_TooltipAbout}">
                        <Path Data="{StaticResource InfoIconGeometry}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="16" Height="16"
                              Stretch="Uniform" />
                    </Button>

                    <Button Content="✕" Style="{StaticResource IconButton}" Click="OnCloseClick" ToolTip="{DynamicResource Str_TooltipHide}" />
                </StackPanel>
            </Grid>

            <!-- ================= 搜索区 ================= -->
            <Grid Grid.Row="1" Margin="13,0,13,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource PlainTextBox}"
                             Height="34" FontSize="13.5"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="OnSearchBoxKeyDown" />
                    <TextBlock Text="{DynamicResource Str_SearchPlaceholder}"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13.5"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextMuted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ComboBox Grid.Column="1"
                          Margin="8,0,0,0"
                          Style="{StaticResource FilterComboBox}"
                          ItemsSource="{Binding FilterLabels}"
                          SelectedIndex="{Binding SelectedFilterIndex}" />
            </Grid>

            <!-- ================= 列表 + 预览（左 1 : 右 2） ================= -->
            <Grid Grid.Row="2" Margin="13,0,13,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MinWidth="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <!-- 列表 -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource BorderSoft}"
                        BorderThickness="1"
                        CornerRadius="9">
                    <Grid>
                        <ListBox x:Name="ClipList"
                                 ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource ClipItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0,2"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 MouseDoubleClick="OnListDoubleClick">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ClipRow}">
                                    <Grid Height="30">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="20" Height="20"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource AccentSoft}"
                                                CornerRadius="5">
                                            <TextBlock Text="{Binding TypeGlyph}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource Accent}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <Grid Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource Str_PinnedTag}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource Accent}"
                                                       Background="{DynamicResource AccentSoft}"
                                                       Padding="4,0"
                                                       Margin="0,0,4,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="★"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource Accent}"
                                                       Margin="0,0,4,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsStarred, Converter={StaticResource BoolToVis}}" />

                                            <!-- 必须放在 * 列里才能正确省略：StackPanel 不约束子元素宽度，
                                                 文字会一直画到时间列下面再被硬切 -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Preview}"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TimeText}"
                                                   FontSize="10.5"
                                                   Margin="0,2,4,0"
                                                   VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextMuted}" />

                                        <!-- 行内删除按钮：悬停或选中时显示（默认折叠放在 Style 里，触发器才能覆盖） -->
                                        <Button Grid.Column="3"
                                                Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Width="24" Height="24"
                                                Margin="0,0,2,0"
                                                ToolTip="{DynamicResource Str_Delete}">
                                            <Path Data="{StaticResource DeleteIconGeometry}" Width="14" Height="14" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 空状态 -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="24"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource Str_EmptyTitle}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding EmptyHint}"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       MaxWidth="280"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 左右可拖动分隔条 -->
                <GridSplitter Grid.Column="1"
                              Width="9"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              ShowsPreview="False"
                              Background="Transparent"
                              Cursor="SizeWE"
                              ToolTip="{DynamicResource Str_GripTip}">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <!-- 根元素必须有画刷，否则中间透明区域接不到鼠标 -->
                            <Grid Background="{TemplateBinding Background}">
                                <!-- 静止时也留一条淡线，否则用户不知道中间这条缝可以拖 -->
                                <Border x:Name="Grip"
                                        Width="2"
                                        HorizontalAlignment="Center"
                                        CornerRadius="1"
                                        Background="{DynamicResource BorderStrong}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- 预览 -->
                <Border Grid.Column="2"
                        Margin="0"
                        Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource BorderSoft}"
                        BorderThickness="1"
                        CornerRadius="9">
                    <Grid Margin="14,12,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 第一排：类型徽标 + 编辑操作（保存/后退/前进）+ 条目操作（复制/置顶/收藏/删除） -->
                        <StackPanel Grid.Row="0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding SelectedRow.TypeName}"
                                           FontSize="11"
                                           Foreground="{DynamicResource Accent}"
                                           Background="{DynamicResource AccentSoft}"
                                           Padding="6,2"
                                           VerticalAlignment="Center" />

                                <!-- 编辑操作：保存 / 后退（撤销）/ 前进（重做） -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="26" Margin="0,0,2,0"
                                            ToolTip="{DynamicResource Str_SaveHint}" Command="{Binding SaveCommand}">
                                        <Path Data="{StaticResource SaveIconGeometry}" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="26" Margin="0,0,2,0"
                                            ToolTip="{DynamicResource Str_Back}"
                                            Command="{x:Static ApplicationCommands.Undo}"
                                            CommandTarget="{Binding ElementName=ContentBox}">
                                        <Path Data="{StaticResource BackIconGeometry}" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="26"
                                            ToolTip="{DynamicResource Str_Forward}"
                                            Command="{x:Static ApplicationCommands.Redo}"
                                            CommandTarget="{Binding ElementName=ContentBox}">
                                        <Path Data="{StaticResource ForwardIconGeometry}" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="26" Margin="0,0,2,0"
                                            ToolTip="{DynamicResource Str_Copy}" Command="{Binding CopyCommand}">
                                        <Path Data="{StaticResource CopyIconGeometry}" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="26" Margin="0,0,2,0"
                                            ToolTip="{DynamicResource Str_Pin}" Command="{Binding TogglePinCommand}">
                                        <Path Data="{StaticResource PinIconGeometry}" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="26" Margin="0,0,2,0"
                                            ToolTip="{DynamicResource Str_Star}" Command="{Binding ToggleStarCommand}">
                                        <Path Data="{StaticResource StarIconGeometry}" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="26"
                                            ToolTip="{DynamicResource Str_Delete}" Command="{Binding DeleteCommand}">
                                        <Path Data="{StaticResource DeleteIconGeometry}" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 第二排：来源（带图标） + 时间 -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Path Grid.Column="0" Data="{StaticResource SourceIconGeometry}" Width="13" Height="13"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource TextMuted}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" Margin="0,0,5,0" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedRow.SourceText}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2"
                                           Text="{Binding SelectedRow.TimeText}"
                                           FontSize="11"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <Border Grid.Row="1" Height="1" Margin="0,10,0,10" Background="{DynamicResource BorderSoft}"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />

                        <!-- 正文（可编辑：修改后点保存写回片段并同步剪贴板） -->
                        <TextBox Grid.Row="2"
                                 x:Name="ContentBox"
                                 Text="{Binding EditContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 TextBlock.LineHeight="18"
                                 IsUndoEnabled="True"
                                 UndoLimit="100"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 FontFamily="{StaticResource FontMono}"
                                 FontSize="12.5"
                                 Foreground="{DynamicResource TextPrimary}"
                                 CaretBrush="{DynamicResource Accent}"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <TextBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                            </TextBox.Resources>
                        </TextBox>

                        <TextBlock Grid.Row="2"
                                   Text="{DynamicResource Str_NoSelection}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= 状态栏 ================= -->
            <Grid Grid.Row="3" Margin="15,0,15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           FontSize="10.5"
                           Margin="10,0,0,0"
                           Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center"
                           Text="{DynamicResource Str_StatusBar}" />
            </Grid>
        </Grid>
    </Border>
</Window>
