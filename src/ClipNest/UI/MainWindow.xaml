<Window x:Class="ClipNest.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:ClipNest.UI.ViewModels"
        xmlns:infra="clr-namespace:ClipNest.UI.Infrastructure"
        Title="ClipNest"
        Width="940" Height="640"
        MinWidth="720" MinHeight="440"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBg}"
        Icon="{StaticResource AppIconImage}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource FontUi}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="5"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <infra:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <infra:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />

        <Style x:Key="ClipItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Margin="6,1"
                                Padding="10,7"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedBg}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- ================= 标题栏（自绘，可拖拽） ================= -->
            <Grid Grid.Row="0" Background="{DynamicResource WindowBg}" MouseLeftButtonDown="OnHeaderMouseDown">
                <StackPanel Orientation="Horizontal" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Image Source="{StaticResource AppIconImage}" Width="15" Height="15" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="ClipNest" Margin="7,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0">
                    <Button Content="{Binding PauseLabel}"
                            Command="{Binding TogglePauseCommand}"
                            Style="{StaticResource GhostButton}"
                            Height="24" Padding="9,0" FontSize="11.5"
                            Margin="0,0,6,0" />
                    <Button Content="设置" Style="{StaticResource IconButton}" Width="42" Click="OnSettingsClick" ToolTip="设置" />
                    <Button Content="✕" Style="{StaticResource IconButton}" Width="30" Click="OnCloseClick" ToolTip="隐藏窗口 (Esc)" />
                </StackPanel>
            </Grid>

            <!-- ================= 搜索区 ================= -->
            <Grid Grid.Row="1" Margin="13,0,13,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource PlainTextBox}"
                             Height="34" FontSize="13.5"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="OnSearchBoxKeyDown" />
                    <TextBlock Text="搜索片段…   按 / 回到搜索框"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13.5"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextMuted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ComboBox Grid.Column="1"
                          Margin="8,0,0,0"
                          Style="{StaticResource FilterComboBox}"
                          ItemsSource="{Binding FilterLabels}"
                          SelectedIndex="{Binding SelectedFilterIndex}" />
            </Grid>

            <!-- ================= 列表 + 预览 ================= -->
            <Grid Grid.Row="2" Margin="13,0,13,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.12*" MinWidth="300" />
                    <ColumnDefinition Width="1*" MinWidth="240" />
                </Grid.ColumnDefinitions>

                <!-- 列表 -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource BorderSoft}"
                        BorderThickness="1"
                        CornerRadius="9">
                    <Grid>
                        <ListBox x:Name="ClipList"
                                 ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource ClipItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0,4"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 MouseDoubleClick="OnListDoubleClick">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ClipRow}">
                                    <Grid Height="38">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="22" Height="22"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource AccentSoft}"
                                                CornerRadius="5">
                                            <TextBlock Text="{Binding TypeGlyph}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Accent}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <Grid Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                <TextBlock Text="置顶"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource Accent}"
                                                           Background="{DynamicResource AccentSoft}"
                                                           Padding="4,0"
                                                           Margin="0,0,4,0"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="★"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource Accent}"
                                                           Margin="0,0,4,0"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsStarred, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding Preview}"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding MetaText}"
                                                       Margin="0,1,0,0"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TimeText}"
                                                   FontSize="10.5"
                                                   Margin="0,2,2,0"
                                                   VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 空状态 -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="24"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="巢还是空的"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding EmptyHint}"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       MaxWidth="280"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 预览 -->
                <Border Grid.Column="1"
                        Margin="9,0,0,0"
                        Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource BorderSoft}"
                        BorderThickness="1"
                        CornerRadius="9">
                    <Grid Margin="14,12,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 元信息 -->
                        <Grid Grid.Row="0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedRow.TypeName}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Accent}"
                                           Background="{DynamicResource AccentSoft}"
                                           Padding="6,2"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedRow.SourceText}"
                                           Margin="8,0,0,0"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedRow.TimeText}"
                                           Margin="8,0,0,0"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="复制" Style="{StaticResource GhostButton}" Height="24" Padding="10,0"
                                        FontSize="11.5" Margin="0,0,4,0" Command="{Binding CopyCommand}" />
                                <Button Content="置顶" Style="{StaticResource GhostButton}" Height="24" Padding="10,0"
                                        FontSize="11.5" Margin="0,0,4,0" Command="{Binding TogglePinCommand}" />
                                <Button Content="收藏" Style="{StaticResource GhostButton}" Height="24" Padding="10,0"
                                        FontSize="11.5" Margin="0,0,4,0" Command="{Binding ToggleStarCommand}" />
                                <Button Content="删除" Style="{StaticResource GhostButton}" Height="24" Padding="10,0"
                                        FontSize="11.5" Command="{Binding DeleteCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Height="1" Margin="0,10,0,10" Background="{DynamicResource BorderSoft}"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />

                        <!-- 正文 -->
                        <TextBox Grid.Row="2"
                                 Text="{Binding SelectedContent, Mode=OneWay}"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="False"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 FontFamily="{StaticResource FontMono}"
                                 FontSize="12.5"
                                 Foreground="{DynamicResource TextPrimary}"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <TextBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                            </TextBox.Resources>
                        </TextBox>

                        <TextBlock Grid.Row="2"
                                   Text="选中左侧任意片段即可预览全文"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= 状态栏 ================= -->
            <Grid Grid.Row="3" Margin="15,0,15,0">
                <TextBlock Text="{Binding StatusText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" />
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Text="↑↓ 选择   Enter 复制   Ctrl+P 置顶   Ctrl+S 收藏   Del 删除   Esc 收起" />
            </Grid>
        </Grid>
    </Border>
</Window>
