<UserControl x:Class="ClipNest.UI.Controls.HotKeyBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontUi}">

    <Border x:Name="Root"
            Focusable="True"
            Background="{StaticResource SurfaceBg}"
            BorderBrush="{StaticResource BorderSoft}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10,6"
            MinWidth="180"
            Cursor="Hand"
            MouseLeftButtonDown="OnMouseDown"
            GotKeyboardFocus="OnFocusChanged"
            LostKeyboardFocus="OnFocusChanged"
            PreviewKeyDown="OnPreviewKeyDown">
        <Grid>
            <TextBlock x:Name="ValueText"
                       FontSize="12.5"
                       FontFamily="{StaticResource FontMono}"
                       Foreground="{StaticResource TextPrimary}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="HintText"
                       FontSize="12"
                       Foreground="{StaticResource TextMuted}"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
